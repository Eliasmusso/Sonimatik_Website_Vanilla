---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import WindowFrame from '../components/WindowFrame.astro';
import Button from '../components/Button.astro';
import CrossLinks from '../components/CrossLinks.astro';
import PlattformHub from '../components/PlattformHub.astro';

const DOC = 'M2 1h9.5L17 6.5V25H2Z';
const DOC_FOLD = 'M11.5 1v5.5H17';
const DOC_LINES = [
  { y: 12, w: 8 },
  { y: 16, w: 11 },
];
const stages = [
  { label: 'Einzelbelege', note: 'aus Bestellung und Lieferung' },
  { label: 'Sammelrechnung', note: 'automatisiert gebündelt' },
  { label: 'XRechnung · ZUGFeRD', note: 'normkonform erzeugt' },
  { label: 'Peppol', note: 'elektronisch versandt' },
  { label: 'Archiv', note: 'revisionssicher abgelegt' },
];

const items = [
  {
    id: 'mcemm',
    name: 'McEmm',
    kicker: 'B2B Plattform',
    claim: 'Die Plattform für die Hörakustikbranche',
    text: 'McEmm verbindet die Mitgliedsbetriebe der Meditrend eG mit Industrie und Lieferanten. Bestellungen, Konditionen und Stammdaten laufen über eine gemeinsame Oberfläche statt über Einzelabsprachen.',
    figure: 'hub' as const,
    tone: 'light' as const,
    facts: [
      { label: 'Nutzung', value: 'rund 400 Mitgliedsbetriebe' },
      { label: 'Rolle', value: 'Entwicklung und laufender Betrieb' },
      { label: 'Aufbau', value: 'modular, über Schnittstellen angebunden' },
    ],
    cta: { label: 'Anfrage zu McEmm', href: '/kontakt?betreff=mcemm' },
  },
  {
    id: 'zentralfakturierung',
    name: 'Zentralfakturierung',
    kicker: 'Automatisierte Fakturierung',
    claim: 'Aus vielen Einzelbelegen wird eine Rechnung',
    text: 'Für die Meditrend eG bündeln wir Einzelbelege automatisiert zu Sammelrechnungen, erzeugen daraus elektronische Rechnungen in den geforderten Formaten und archivieren sie revisionssicher.',
    figure: 'pipeline' as const,
    tone: 'light' as const,
    facts: [
      { label: 'Formate', value: 'XRechnung, ZUGFeRD' },
      { label: 'Versandweg', value: 'Peppol über B2Brouter' },
      { label: 'Archivierung', value: 'revisionssicher' },
    ],
    cta: { label: 'Anfrage zur Zentralfakturierung', href: '/kontakt?betreff=zentralfakturierung' },
  },
  {
    id: 'fachanwendungen',
    name: 'Individuelle Fachanwendungen',
    kicker: 'Speziallösungen',
    claim: 'Für Anforderungen, die keine Standardlösung abdeckt',
    text: 'Wenn Prozesse zu spezifisch für Standardsoftware sind, entwickeln wir Fachanwendungen für Partnerbetriebe und Kooperationen im Zuschnitt auf den konkreten Ablauf.',
    figure: 'none' as const,
    tone: 'invert' as const,
    facts: [
      { label: 'Einsatz', value: 'Partnerbetriebe und Kooperationen' },
      { label: 'Basis', value: 'PHP/Laravel, offene Standards' },
    ],
    cta: { label: 'Vorhaben beschreiben', href: '/kontakt?betreff=allgemein' },
  },
];
---

<Layout
  title="Produkte & Referenzprojekte | Sonimatik"
  description="McEmm, die B2B Plattform für rund 400 Hörakustikbetriebe, und die Zentralfakturierung mit XRechnung und ZUGFeRD als Referenzen aus der Praxis."
>
  <PageHero
    title="Referenzprojekte"
    lead="Zwei Systeme zeigen am besten, was wir bauen: eine B2B Plattform im täglichen Einsatz und eine vollständig automatisierte Fakturierung."
  />

  {
    items.map((item, i) => {
      const isInvert = item.tone === 'invert';
      return (
        <section
          id={item.id}
          class:list={[
            'relative py-[var(--spacing-section)] text-navy-600',
            isInvert ? 'bg-brand-300' : 'bg-brand-50',
            i === 1 && 'border-t border-navy-500/16',
          ]}
        >
          <div class="w-full max-w-[84rem] mx-auto px-[var(--spacing-gutter)]">
            <div class="grid grid-cols-12 gap-x-[clamp(1rem,2.5vw,2rem)] gap-y-[clamp(2.5rem,5vw,3.5rem)] items-start">
              <div class="col-span-12 min-[62rem]:col-span-5">
                <p
                  class:list={[
                    'm-0 flex items-center gap-3 mb-4 font-display font-medium text-eyebrow tracking-[0.12em] uppercase',
                    isInvert ? 'text-navy-700' : 'text-brand-700',
                  ]}
                  data-reveal
                >
                  <span class="block w-6 h-[3px] rounded-full bg-current" aria-hidden="true" />
                  {item.kicker}
                </p>
                <h2
                  class="m-0 font-display font-bold text-navy-900 text-h2 leading-[1.15] tracking-[-0.018em]"
                  data-reveal
                  style="--reveal-delay:60ms"
                >
                  {item.name}
                </h2>
                <p
                  class:list={[
                    'm-0 mt-3.5 font-display font-medium text-lead leading-[1.4] tracking-[-0.015em] max-w-[30ch]',
                    isInvert ? 'text-navy-700' : 'text-brand-700',
                  ]}
                  data-reveal
                  style="--reveal-delay:110ms"
                >
                  {item.claim}
                </p>
                <p
                  class="m-0 mt-5 text-navy-500 max-w-[48ch]"
                  data-reveal
                  style="--reveal-delay:160ms"
                >
                  {item.text}
                </p>

                <dl
                  class="flex flex-col m-0 mt-[clamp(1.75rem,3.5vw,2.25rem)]"
                  data-reveal
                  style="--reveal-delay:210ms"
                >
                  {item.facts.map((f) => (
                    <div
                      class:list={[
                        'flex flex-wrap gap-y-1 gap-x-4 py-3 border-t',
                        isInvert ? 'border-navy-500/22' : 'border-navy-500/16',
                      ]}
                    >
                      <dt class="shrink-0 basis-32 font-display font-medium text-xs tracking-[0.08em] uppercase text-navy-500 pt-0.5">
                        {f.label}
                      </dt>
                      <dd class="m-0 text-small text-navy-600">{f.value}</dd>
                    </div>
                  ))}
                </dl>

                <div class="mt-8" data-reveal style="--reveal-delay:260ms">
                  <Button
                    href={item.cta.href}
                    variant={i === 0 ? 'primary-invert' : 'ghost-invert'}
                  >
                    {item.cta.label}
                  </Button>
                </div>
              </div>

              {item.figure !== 'none' && (
                <div
                  class="col-span-12 min-[62rem]:col-start-7 min-[62rem]:col-span-6"
                  data-reveal
                  style="--reveal-delay:140ms"
                >
                  <WindowFrame
                    title={
                      item.figure === 'hub'
                        ? 'Plattformtopologie schematisch'
                        : 'Belegweg schematischer Ablauf'
                    }
                    meta={item.figure === 'hub' ? 'Struktur' : 'Prozess'}
                  >
                    {item.figure === 'hub' ? (
                      <PlattformHub />
                    ) : (
                      <figure class="m-0">
                        <ol class="flex flex-col m-0 p-0 list-none">
                          {stages.map((stage, sIdx) => (
                            <li
                              class="flex items-center gap-[clamp(1rem,3vw,1.75rem)] py-4 border-t border-white/8 first:border-t-0 first:pt-0 animate-[pipe-flow_5s_var(--ease-brand)_infinite]"
                              style={`animation-delay:${sIdx * 0.6}s`}
                            >
                              <div class="shrink-0 basis-[40%] max-w-48 flex items-center" aria-hidden="true">
                                {sIdx === 0 && (
                                  <svg class="block w-full max-w-44 h-auto overflow-visible" viewBox="0 0 84 28" fill="none">
                                    {[0, 1, 2, 3, 4].map((n) => (
                                      <g transform={`translate(${n * 16} 1)`}>
                                        <path
                                          d={DOC}
                                          class="fill-navy-800 stroke-navy-200 stroke-[1.1] [stroke-linejoin:round] [stroke-linecap:round]"
                                        />
                                        <path
                                          d={DOC_FOLD}
                                          class="stroke-navy-200 stroke-[1.1] [stroke-linejoin:round] [stroke-linecap:round]"
                                        />
                                        {DOC_LINES.map((l) => (
                                          <path
                                            d={`M5 ${l.y}h${l.w}`}
                                            class="stroke-navy-300 stroke-[0.9] [stroke-linecap:round]"
                                          />
                                        ))}
                                      </g>
                                    ))}
                                  </svg>
                                )}
                                {sIdx === 1 && (
                                  <svg class="block w-full max-w-44 h-auto overflow-visible" viewBox="0 0 84 28" fill="none">
                                    <g transform="translate(2 -2) scale(1.22)">
                                      <path
                                        d={DOC}
                                        class="fill-navy-800 stroke-brand-300 stroke-[1.3] [stroke-linejoin:round] [stroke-linecap:round]"
                                      />
                                      <path
                                        d={DOC_FOLD}
                                        class="stroke-brand-300 stroke-[1.3] [stroke-linejoin:round] [stroke-linecap:round]"
                                      />
                                      {[12, 16, 20].map((y) => (
                                        <path
                                          d={`M5 ${y}h${y === 20 ? 6 : 11}`}
                                          class="stroke-brand-400 stroke-[0.9] [stroke-linecap:round]"
                                        />
                                      ))}
                                    </g>
                                  </svg>
                                )}
                                {sIdx === 2 && (
                                  <div class="flex gap-1.5">
                                    <span class="py-[0.1875rem] px-2 border border-brand-300/35 rounded-[3px] font-display font-medium text-[0.6875rem] tracking-[0.04em] text-brand-300">
                                      XML
                                    </span>
                                    <span class="py-[0.1875rem] px-2 border border-brand-300/35 rounded-[3px] font-display font-medium text-[0.6875rem] tracking-[0.04em] text-brand-300">
                                      PDF/A
                                    </span>
                                  </div>
                                )}
                                {sIdx === 3 && (
                                  <svg class="block w-full max-w-44 h-auto overflow-visible" viewBox="0 0 84 28" fill="none">
                                    <path
                                      class="stroke-brand-300/25 stroke-[1.4] [stroke-linecap:round]"
                                      d="M4 14h60"
                                    />
                                    <path
                                      class="stroke-brand-300 stroke-[1.4] [stroke-linecap:round] [stroke-linejoin:round]"
                                      d="M62 9.5l5 4.5-5 4.5"
                                    />
                                    <g class="animate-[pipe-send_2.8s_var(--ease-brand)_infinite]">
                                      <g transform="translate(0 7) scale(0.52)">
                                        <path
                                          d={DOC}
                                          class="fill-navy-800 stroke-brand-300 stroke-[2.1] [stroke-linejoin:round]"
                                        />
                                        <path
                                          d={DOC_FOLD}
                                          class="fill-navy-800 stroke-brand-300 stroke-[2.1] [stroke-linejoin:round]"
                                        />
                                      </g>
                                    </g>
                                  </svg>
                                )}
                                {sIdx === 4 && (
                                  <svg class="block w-full max-w-44 h-auto overflow-visible" viewBox="0 0 84 28" fill="none">
                                    <g>
                                      {[0, 1, 2].map((n) => (
                                        <g transform={`translate(${8 + n * 13} 0) scale(0.72)`}>
                                          <path
                                            d={DOC}
                                            class="fill-navy-800 stroke-navy-200 stroke-[1.1] [stroke-linejoin:round] [stroke-linecap:round]"
                                          />
                                          <path
                                            d={DOC_FOLD}
                                          class="stroke-navy-200 stroke-[1.1] [stroke-linejoin:round] [stroke-linecap:round]"
                                          />
                                        </g>
                                      ))}
                                    </g>
                                    <path
                                      class="stroke-brand-300 stroke-[1.4] [stroke-linecap:round] fill-none"
                                      d="M3 17v7a2 2 0 002 2h44a2 2 0 002-2v-7"
                                    />
                                  </svg>
                                )}
                              </div>

                              <div class="flex-1 flex flex-col gap-0.5 min-w-0">
                                <span class="font-display font-bold text-[0.9375rem] tracking-[-0.01em] text-white">
                                  {stage.label}
                                </span>
                                <span class="text-[0.8125rem] text-grau-300">{stage.note}</span>
                              </div>
                            </li>
                          ))}
                        </ol>

                        <figcaption class="mt-6 pt-4 border-t border-white/8 text-[0.8125rem] text-grau-300">
                          Weg eines Belegs von der Erfassung bis zur revisionssicheren Ablage.
                        </figcaption>
                      </figure>
                    )}
                  </WindowFrame>
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  <CrossLinks
    items={[
      {
        label: 'Leistungen',
        href: '/leistungen',
        text: 'Die Felder, aus denen diese Systeme entstehen.',
      },
      {
        label: 'Technik & Sicherheit',
        href: '/technik-sicherheit',
        text: 'Wie die Infrastruktur dahinter aufgesetzt ist.',
      },
      { label: 'Über uns', href: '/ueber-uns#zielgruppen', text: 'Für wen wir solche Systeme bauen.' },
    ]}
  />
</Layout>
