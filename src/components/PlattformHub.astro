---
const rows = 7;
const cols = 5;
const NODE = 6;
const marks = Array.from({ length: rows * cols }, (_, i) => ({
  x: 14 + (i % cols) * 22,
  y: 26 + Math.floor(i / cols) * 20,
}));

const right = [
  { label: 'Industrie', y: 60 },
  { label: 'Lieferanten', y: 105 },
  { label: 'Auswertung', y: 150 },
];

const steps = [
  'Rund 400 Mitgliedsbetriebe greifen auf die Plattform zu.',
  'Die Plattform hält Stammdaten, Konditionen und Bestellungen zentral.',
  'Industrie und Lieferanten sind über Schnittstellen angebunden.',
  'Auswertungen und Abrechnung laufen aus demselben Datenbestand.',
];
---

<figure class="m-0 text-brand-300">
  <svg
    class="hidden sm:block w-full h-auto"
    viewBox="0 0 420 210"
    aria-hidden="true"
    preserveAspectRatio="xMidYMid meet"
  >
    <g class="fill-navy-300">
      {marks.map((m) => <rect x={m.x} y={m.y} width={NODE} height={NODE} rx="1.5" />)}
    </g>

    <g fill="none">
      {
        [0, 1, 2, 3, 4].map((i) => (
          <path
            d={`M 122 ${34 + i * 30} C 160 ${34 + i * 30}, 160 105, 186 105`}
            class="stroke-brand-300/22 stroke-1"
          />
        ))
      }
    </g>

    <rect class="fill-navy-600" x="186" y="86" width="86" height="38" rx="8" />
    <text class="fill-white font-display font-bold text-[12px]" x="229" y="110" text-anchor="middle"
      >Plattform</text
    >

    <g fill="none">
      {
        right.map((r) => (
          <path
            d={`M 272 105 C 298 105, 298 ${r.y}, 322 ${r.y}`}
            class="stroke-brand-300/22 stroke-1"
          />
        ))
      }
    </g>

    <g>
      {
        right.map((r) => (
          <>
            <rect class="fill-navy-600" x="322" y={r.y - 13} width="84" height="26" rx="6" />
            <text
              class="fill-grau-200 font-display font-medium text-[10px]"
              x="364"
              y={r.y + 4}
              text-anchor="middle"
            >
              {r.label}
            </text>
          </>
        ))
      }
    </g>

    <g fill="none">
      <path
        d="M 122 94 C 160 94, 160 105, 186 105"
        pathLength="100"
        class="stroke-brand-300 stroke-[1.75] [stroke-dasharray:12_100] drop-shadow-[0_0_3px_rgb(170_207_223/0.5)] animate-[hub-run_3.2s_linear_infinite]"
      />
      <path
        d="M 272 105 C 298 105, 298 60, 322 60"
        pathLength="100"
        class="stroke-brand-300 stroke-[1.75] [stroke-dasharray:12_100] drop-shadow-[0_0_3px_rgb(170_207_223/0.5)] animate-[hub-run_3.2s_linear_infinite] [animation-delay:1.1s]"
      />
      <path
        d="M 272 105 C 298 105, 298 150, 322 150"
        pathLength="100"
        class="stroke-brand-300 stroke-[1.75] [stroke-dasharray:12_100] drop-shadow-[0_0_3px_rgb(170_207_223/0.5)] animate-[hub-run_3.2s_linear_infinite] [animation-delay:1.7s]"
      />
    </g>

    <text
      class="fill-grau-500 font-display font-medium text-[10px] tracking-[0.06em]"
      x="14"
      y="188">~400 Mitgliedsbetriebe</text
    >
  </svg>

  <figcaption
    class="hidden sm:block mt-5 pt-4 border-t border-white/8 text-[0.8125rem] text-grau-300"
  >
    Schematische Topologie der Plattform: Betriebe, Plattform, Industrie.
  </figcaption>

  <ol class="flex flex-col m-0 p-0 list-none sm:hidden">
    {
      steps.map((s) => (
        <li class="relative py-3 pl-7 border-t border-white/8 first:border-t-0 text-small text-grau-300 before:content-[''] before:absolute before:left-0 before:top-[1.35rem] before:w-3.5 before:h-[2px] before:rounded-full before:bg-brand-300 not-last:after:content-[''] not-last:after:absolute not-last:after:left-1.5 not-last:after:top-[1.7rem] not-last:after:-bottom-[0.4rem] not-last:after:w-px not-last:after:bg-brand-300/22">
          {s}
        </li>
      ))
    }
  </ol>
</figure>
