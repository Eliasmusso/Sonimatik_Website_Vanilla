---
interface Props {
  items: ReadonlyArray<{ label: string; href: string; text: string }>;
}

const { items } = Astro.props;
---

<section class="py-[clamp(3rem,6vw,5rem)] border-t border-white/8">
  <div class="w-full max-w-[84rem] mx-auto px-[var(--spacing-gutter)]">
    <h2
      class="m-0 mb-6 font-display font-medium text-eyebrow tracking-[0.12em] uppercase text-brand-300"
    >
      Weiterlesen
    </h2>
    <ul class="flex flex-col m-0 p-0 list-none">
      {
        items.map((item, i) => (
          <li data-reveal style={`--reveal-delay:${i * 80}ms`} class="last:border-b last:border-white/8">
            <a
              href={item.href}
              class="group flex items-baseline gap-4 py-[1.125rem] border-t border-white/8 no-underline transition-colors duration-240 hover:border-brand-300/40"
            >
              <span
                class="shrink-0 w-3.5 h-[2px] rounded-full bg-brand-300 -translate-y-[0.35em] origin-left transition-transform duration-240 group-hover:scale-x-170"
                aria-hidden="true"
              />
              <span class="flex-1 flex flex-col gap-1">
                <span class="font-display font-bold text-h4 tracking-[-0.01em] text-white">
                  {item.label}
                </span>
                <span class="text-small text-grau-300 max-w-[52ch]">{item.text}</span>
              </span>
              <span
                class="shrink-0 text-brand-300 transition-transform duration-240 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
