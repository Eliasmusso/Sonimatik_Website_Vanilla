---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'primary-invert' | 'ghost-invert';
}

const { href, variant = 'primary' } = Astro.props;

const variantClasses = {
  primary: 'bg-brand-300 text-navy-900 hover:bg-brand-200',
  'primary-invert': 'bg-navy-700 text-brand-200 hover:bg-navy-600',
  ghost: 'bg-transparent text-white border-white/18 hover:border-brand-300/55 hover:text-brand-200',
  'ghost-invert':
    'bg-transparent text-navy-800 border-navy-500/45 hover:border-navy-700 hover:text-navy-900',
}[variant];

const showArrow = variant === 'primary' || variant === 'primary-invert';
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2.5 py-3.5 px-[1.375rem] rounded-control font-display font-bold text-[0.9375rem] tracking-[-0.01em] leading-none no-underline cursor-pointer border border-transparent transition-colors duration-220',
    variantClasses,
  ]}
>
  <span><slot /></span>
  {
    showArrow && (
      <svg
        class="shrink-0 w-4 h-4 transition-transform duration-220 group-hover:translate-x-[3px]"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M2.5 8h10M9 4.5 12.5 8 9 11.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
