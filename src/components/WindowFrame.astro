---
interface Props {
  title: string;
  meta: string;
  tone?: 'on-light' | 'on-deep';
}

const { title, meta, tone = 'on-light' } = Astro.props;
---

<figure
  class:list={[
    'm-0 rounded-[0.75rem] overflow-hidden text-grau-200',
    tone === 'on-deep' ? 'bg-navy-600 border border-white/14' : 'bg-navy-800 border border-transparent',
  ]}
>
  <div
    class:list={[
      'flex items-center gap-3 py-2.5 px-3.5 border-b border-white/8',
      tone === 'on-deep' ? 'bg-navy-500' : 'bg-navy-700',
    ]}
  >
    <span class="flex gap-1.5 shrink-0" aria-hidden="true">
      <span class="w-2 h-2 rounded-full bg-brand-300 opacity-75"></span>
      <span class="w-2 h-2 rounded-full bg-navy-300 opacity-55"></span>
      <span class="w-2 h-2 rounded-full bg-navy-300 opacity-55"></span>
    </span>
    <span
      class="flex-1 min-w-0 font-display font-medium text-[0.8125rem] tracking-[-0.005em] text-grau-200 whitespace-nowrap overflow-hidden text-ellipsis"
    >
      {title}
    </span>
    <span
      class="hidden sm:inline shrink-0 font-display font-medium text-[0.6875rem] tracking-[0.06em] uppercase text-brand-300"
    >
      {meta}
    </span>
  </div>

  <div class="p-[clamp(1.25rem,3vw,2rem)]">
    <slot />
  </div>
</figure>
